{
  "experiment_settings": {
    "description": "GCN批量实验配置文件",
    "default_runs": 50,
    "models": ["gcn", "gat", "hybrid"],
    "window_sizes": [20, 50, 100],
    "data_root": "../../data"
  },
  "model_configs": {
    "gcn": {
      "hidden_dim": 64,
      "dropout": 0.3,
      "description": "纯GCN模型"
    },
    "gat": {
      "hidden_dim": 64,
      "dropout": 0.3,
      "description": "纯GAT模型"
    },
    "hybrid": {
      "hidden_dim": 64,
      "dropout": 0.3,
      "description": "混合GCN+SAGE+GAT模型"
    }
  },
  "experiment_scenarios": {
    "quick_test": {
      "runs": 5,
      "models": ["gcn"],
      "window_sizes": [20],
      "description": "快速测试，用于验证脚本功能"
    },
    "standard": {
      "runs": 50,
      "models": ["gcn", "gat", "hybrid"],
      "window_sizes": [20, 50, 100],
      "description": "标准实验，符合README要求"
    },
    "comprehensive": {
      "runs": 100,
      "models": ["gcn", "gat", "hybrid"],
      "window_sizes": [20, 50, 100],
      "description": "全面实验，更多运行次数"
    }
  },
  "output_settings": {
    "save_detailed_results": false,
    "output_formats": ["json", "csv"],
    "generate_plots": false
  },
  "performance_targets": {
    "min_accuracy": 0.7,
    "min_f1_score": 0.7,
    "max_training_time": 300,
    "description": "性能目标基准"
  }
}